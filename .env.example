NEXT_PUBLIC_SITE_URL=https://ath-portfolio.example.com
CONTACT_FORM_RECIPIENT_EMAIL=

# Admin dashboard (/admin) — see README for how to generate these.
# Any "$" in the bcrypt hash MUST be escaped as "\$" in .env files, or
# Next.js's built-in $VAR expansion will corrupt it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
